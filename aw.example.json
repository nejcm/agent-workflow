{
  "host": "laptop",
  "defaultHost": true,
  "pollIntervalMs": 60000,
  "workspaceRoot": "~/agent-ws",
  "reposRoot": "~/agent-repos",
  "tmuxSession": "aw",
  "maxConcurrent": 2,
  "defaults": {
    "baseBranch": "main",
    "agent": "claude",
    "sandbox": "nono",
    "testCmd": "bun test",
    "autoMerge": "off"
  },
  "repos": [
    "acme/web",
    {
      "name": "acme/api",
      "agent": "codex",
      "testCmd": "make test",
      "maxConcurrent": 1,
      "prompt": "prompts/default.md",
      "autoMerge": "intelligent",
      "criticalPaths": ["src/billing/**"],
      "feedbackAuthors": ["octocat", "lead@acme.com"]
    }
  ],
  "sources": [
    {
      "name": "gh",
      "tracker": "github",
      "readyLabel": "agent",
      "inProgressLabel": "in-progress",
      "inReviewLabel": "in-review"
    },
    {
      "name": "eng",
      "tracker": "linear",
      "team": "ENG",
      "todo": "Todo",
      "inProgress": "In Progress",
      "inReview": "In Review",
      "done": ["Done"]
    }
  ]
}
