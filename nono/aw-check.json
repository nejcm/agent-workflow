{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "name": "aw-check",
    "version": "0.1.0",
    "description": "aw: git's cleanup checks of a session clone, with no network, no credentials and no writes"
  },
  "extends": "default",
  "groups": {
    "include": [
      "git_config"
    ],
    "exclude": [
      "system_write_linux",
      "system_read_linux_core"
    ]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "workdir": {
    "access": "none"
  },
  "filesystem": {
    "write": [
      "/dev/null"
    ],
    "read": [
      "/bin",
      "/sbin",
      "/usr/bin",
      "/usr/sbin",
      "/usr/local/bin",
      "/lib",
      "/lib64",
      "/lib/x86_64-linux-gnu",
      "/lib/aarch64-linux-gnu",
      "/usr/lib",
      "/usr/lib64",
      "/usr/lib/x86_64-linux-gnu",
      "/usr/lib/aarch64-linux-gnu",
      "/usr/local/lib",
      "/usr/local/lib64",
      "/etc/resolv.conf",
      "/run/systemd/resolve",
      "/etc/hosts",
      "/etc/nsswitch.conf",
      "/etc/gai.conf",
      "/etc/group",
      "/etc/ssl",
      "/etc/pki",
      "/etc/ca-certificates",
      "/var/lib/ca-certificates",
      "/etc/crypto-policies",
      "/etc/fonts",
      "/etc/ld.so.cache",
      "/etc/ld.so.conf",
      "/etc/ld.so.conf.d",
      "/etc/localtime",
      "/etc/timezone",
      "/etc/locale.conf",
      "/etc/locale.gen",
      "/etc/alternatives",
      "/etc/os-release",
      "/etc/passwd",
      "/etc/services",
      "/etc/mime.types",
      "/etc/manpath.config",
      "/etc/man_db.conf",
      "/var/cache/man",
      "/run/systemd/userdb",
      "/usr/share",
      "/usr/share/locale",
      "/usr/share/locale-langpack",
      "/usr/share/zoneinfo",
      "/usr/share/terminfo",
      "/usr/share/ca-certificates",
      "/lib/terminfo",
      "/etc/terminfo",
      "/dev/null",
      "/dev/zero",
      "/dev/random",
      "/dev/urandom",
      "/dev/full",
      "/dev/tty",
      "/dev/console",
      "/dev/stdin",
      "/dev/stdout",
      "/dev/stderr",
      "/dev/fd",
      "/proc/self",
      "/proc/cpuinfo",
      "/proc/meminfo",
      "/proc/stat",
      "/proc/loadavg",
      "/proc/version",
      "/proc/filesystems"
    ]
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "LANG",
      "LC_*",
      "TZ"
    ]
  },
  "network": {
    "block": true
  }
}
