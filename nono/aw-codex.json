{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "name": "aw-codex",
    "version": "0.1.0",
    "description": "aw: Codex in its own session clone with its own CODEX_HOME, read-only user instructions and skills"
  },
  "extends": "default",
  "groups": {
    "include": [
      "git_config",
      "mise_manager",
      "bun_runtime",
      "node_runtime"
    ],
    "exclude": [
      "system_write_linux",
      "system_read_linux_core"
    ]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "workdir": {
    "access": "none"
  },
  "filesystem": {
    "write": [
      "/dev/null",
      "/dev/zero",
      "/dev/full",
      "/dev/tty",
      "/dev/stdout",
      "/dev/stderr",
      "/dev/fd",
      "/proc/self/fd"
    ],
    "read": [
      "/bin",
      "/sbin",
      "/usr/bin",
      "/usr/sbin",
      "/usr/local/bin",
      "/lib",
      "/lib64",
      "/lib/x86_64-linux-gnu",
      "/lib/aarch64-linux-gnu",
      "/usr/lib",
      "/usr/lib64",
      "/usr/lib/x86_64-linux-gnu",
      "/usr/lib/aarch64-linux-gnu",
      "/usr/local/lib",
      "/usr/local/lib64",
      "/etc/resolv.conf",
      "/run/systemd/resolve",
      "/etc/hosts",
      "/etc/nsswitch.conf",
      "/etc/gai.conf",
      "/etc/group",
      "/etc/ssl",
      "/etc/pki",
      "/etc/ca-certificates",
      "/var/lib/ca-certificates",
      "/etc/crypto-policies",
      "/etc/fonts",
      "/etc/ld.so.cache",
      "/etc/ld.so.conf",
      "/etc/ld.so.conf.d",
      "/etc/localtime",
      "/etc/timezone",
      "/etc/locale.conf",
      "/etc/locale.gen",
      "/etc/alternatives",
      "/etc/os-release",
      "/etc/passwd",
      "/etc/services",
      "/etc/mime.types",
      "/etc/manpath.config",
      "/etc/man_db.conf",
      "/var/cache/man",
      "/run/systemd/userdb",
      "/usr/share",
      "/usr/share/locale",
      "/usr/share/locale-langpack",
      "/usr/share/zoneinfo",
      "/usr/share/terminfo",
      "/usr/share/ca-certificates",
      "/lib/terminfo",
      "/etc/terminfo",
      "/dev/null",
      "/dev/zero",
      "/dev/random",
      "/dev/urandom",
      "/dev/full",
      "/dev/tty",
      "/dev/console",
      "/dev/stdin",
      "/dev/stdout",
      "/dev/stderr",
      "/dev/fd",
      "/proc/self",
      "/proc/cpuinfo",
      "/proc/meminfo",
      "/proc/stat",
      "/proc/loadavg",
      "/proc/version",
      "/proc/filesystems",
      "$HOME/.claude-aw/plugins",
      "$HOME/.claude/skills",
      "$HOME/.agents/skills",
      "/usr/share/omarchy/default/agents",
      "$HOME/.local/share/mise",
      "$HOME/.bun"
    ],
    "read_file": [
      "$HOME/.claude-aw/settings.json",
      "$HOME/.claude/CLAUDE.md",
      "$HOME/.claude/AGENTS.md"
    ]
  },
  "environment": {
    "set_vars": {
      "GIT_CONFIG_COUNT": "3",
      "GIT_CONFIG_KEY_0": "credential.https://github.com.helper",
      "GIT_CONFIG_VALUE_0": "!f() { echo username=x-access-token; echo \"password=$GITHUB_GIT_TOKEN\"; }; f",
      "GIT_CONFIG_KEY_1": "url.https://github.com/.insteadOf",
      "GIT_CONFIG_VALUE_1": "git@github.com:",
      "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
      "GIT_CONFIG_VALUE_2": "ssh://git@github.com/"
    },
    "allow_vars": [
      "PATH",
      "HOME",
      "USER",
      "LOGNAME",
      "SHELL",
      "TERM",
      "COLORTERM",
      "LANG",
      "LC_*",
      "TZ",
      "TMPDIR",
      "TMP",
      "TEMP",
      "XDG_RUNTIME_DIR",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_CACHE_HOME",
      "CLAUDE_CONFIG_DIR",
      "CLAUDE_CODE_TMPDIR",
      "CLAUDE_CODE_OAUTH_TOKEN",
      "CODEX_HOME",
      "GH_CONFIG_DIR"
    ]
  },
  "network": {
    "network_profile": "codex",
    "allow_domain": [
      "github.com",
      "api.github.com",
      "chatgpt.com",
      "auth.openai.com"
    ],
    "credentials": [
      "github",
      "github_git",
      "anthropic_oauth"
    ],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "env_var": "GH_TOKEN",
        "credential_format": "token {}",
        "endpoint_rules": [
          {
            "method": "*",
            "path": "/repos/**"
          },
          {
            "method": "POST",
            "path": "/graphql"
          },
          {
            "method": "GET",
            "path": "/user"
          }
        ]
      },
      "github_git": {
        "upstream": "https://github.com",
        "credential_key": "cmd://github_git",
        "env_var": "GITHUB_GIT_TOKEN",
        "inject_mode": "basic_auth"
      },
      "anthropic_oauth": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "cmd://anthropic_oauth",
        "env_var": "CLAUDE_CODE_OAUTH_TOKEN",
        "credential_format": "Bearer {}"
      }
    }
  },
  "credential_capture": {
    "github": {
      "command": [
        "gh",
        "auth",
        "token"
      ],
      "timeout_secs": 5,
      "cache_ttl_secs": 900
    },
    "github_git": {
      "command": [
        "sh",
        "-c",
        "printf 'x-access-token:%s' \"$(gh auth token)\""
      ],
      "timeout_secs": 5,
      "cache_ttl_secs": 900
    },
    "anthropic_oauth": {
      "command": [
        "/bin/sh",
        "-p",
        "-c",
        "cd / && exec /usr/bin/env -i HOME=\"$HOME\" \"$AW_BUN\" --no-env-file -e \"$1\"",
        "sh",
        "try{const f=require(\"node:fs\"),d=process.env.HOME+\"/.claude/\",w=Date.now()+3000;while(f.existsSync(d+\".oauth_refresh.lock\")){if(Date.now()>w)process.exit(1);Bun.sleepSync(50)}const c=JSON.parse(f.readFileSync(d+\".credentials.json\",\"utf8\"));const o=c!==null&&typeof c===\"object\"&&!Array.isArray(c)&&Object.hasOwn(c,\"claudeAiOauth\")?c.claudeAiOauth:null;const t=o!==null&&typeof o===\"object\"?o.accessToken:undefined,e=o!==null&&typeof o===\"object\"?o.expiresAt:undefined;if(typeof t===\"string\"&&/^[A-Za-z0-9._-]+$/.test(t)&&Number.isSafeInteger(e)&&e>Date.now()+30000){process.stdout.write(t);process.exit(0)}}catch{}process.exit(1)"
      ],
      "timeout_secs": 5,
      "cache_ttl_secs": 0
    }
  }
}
