[Unit]
Description=tender: close orphan agent PRs, report the rest
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Work/agent-workflow
ExecStart=%h/.bun/bin/bun tender.ts prs --config tender.json
Environment=PATH=%h/.local/share/mise/shims:%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin
