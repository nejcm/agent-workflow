[Unit]
Description=tender: start agent sessions for ready tickets

[Service]
Type=simple
WorkingDirectory=%h/Work/agent-workflow
ExecStart=%h/.bun/bin/bun tender.ts run --config tender.json
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=30
# Only stop the poller; the tmux server lives in this cgroup (sessions run in their own scopes).
KillMode=process

[Install]
WantedBy=default.target
